      {
        "name": "Bug",
        "meaning": "An unexpected problem or behavior",
        "origin": "existing; native Type value (intel org)"
      },
      {
        "name": "Feature",
        "meaning": "A request, idea, or new functionality",
        "origin": "existing; native Type value (intel org)"
      },
      {
        "name": "Task",
        "meaning": "A specific piece of work",
        "origin": "existing; native Type value (intel org)"
      },
      {
        "name": "Epic",
        "meaning": "Group of related tasks",
        "origin": "existing; native Type value (intel org); target of old 'long term' label"
      }
    ]
  },
